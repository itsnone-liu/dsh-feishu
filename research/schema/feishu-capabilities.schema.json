{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dsh-feishu/research/feishu-capabilities",
  "title": "R2 Feishu open platform capability matrix",
  "type": "object",
  "required": [
    "researchedAt",
    "permissions",
    "cardPatchRateLimit",
    "fileUpload",
    "groupChat",
    "fileMessage",
    "messageResource"
  ],
  "additionalProperties": false,
  "properties": {
    "researchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "researchedBy": { "type": "string" },
    "summary": { "type": "string" },
    "conflictsWithBaseline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "baseline", "finding", "explanation"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "baseline": {},
          "finding": {},
          "explanation": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } }
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scope", "consoleName", "purpose", "requiredFor", "sources"],
        "additionalProperties": false,
        "properties": {
          "scope": { "type": "string" },
          "consoleName": { "type": "string" },
          "purpose": { "type": "string" },
          "requiredFor": {
            "type": "array",
            "items": { "enum": ["p2p-text", "p2p-image", "group", "file-upload", "long-output", "long-connection"] },
            "minItems": 1
          },
          "alreadyGrantedInBaseline": { "type": "boolean" },
          "notes": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "pattern": "^https?://" },
            "minItems": 1
          }
        }
      }
    },
    "cardPatchRateLimit": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "qps": { "type": ["number", "null"] },
        "burst": { "type": ["integer", "null"] },
        "perCardQps": { "type": ["number", "null"] },
        "exceedBehavior": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://" },
          "minItems": 1
        }
      }
    },
    "fileUpload": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "api": { "type": ["string", "null"] },
        "maxBytes": { "type": ["integer", "null"] },
        "allowedTypes": { "type": ["array", "null"], "items": { "type": "string" } },
        "sendFlow": { "type": ["string", "null"] },
        "requiredScopes": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://" },
          "minItems": 1
        }
      }
    },
    "groupChat": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "eventExample": {},
        "mentionStructure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "example": {},
            "placeholderFormat": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "botOpenIdDiscovery": { "type": ["string", "null"] },
        "replyStrategy": { "type": ["string", "null"] },
        "requiredScopes": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://" },
          "minItems": 1
        }
      }
    },
    "fileMessage": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "eventExample": {},
        "contentShape": {},
        "messageResourceSupported": { "type": ["boolean", "null"] },
        "notes": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://" },
          "minItems": 1
        }
      }
    },
    "messageResource": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "supportedTypes": { "type": "array", "items": { "enum": ["image", "file"] } },
        "sizeLimitBytes": { "type": ["integer", "null"] },
        "mergedForwardDownloadable": { "type": ["boolean", "null"] },
        "notes": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://" },
          "minItems": 1
        }
      }
    },
    "longConnection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": { "type": "string" },
        "limits": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } }
      }
    }
  }
}
