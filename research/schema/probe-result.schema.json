{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dsh-feishu/research/probe-result",
  "title": "Probe script result envelope (research/out/*.json)",
  "type": "object",
  "required": ["probeId", "ranAt", "pass", "results"],
  "additionalProperties": false,
  "properties": {
    "probeId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "ranAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpointUsed": { "type": "string" },
        "modelsProbed": { "type": "array", "items": { "type": "string" } },
        "nodeVersion": { "type": "string" }
      }
    },
    "pass": { "type": "boolean" },
    "results": { "type": "array", "items": { "type": "object" } },
    "log": { "type": "array", "items": { "type": "string" } }
  }
}
