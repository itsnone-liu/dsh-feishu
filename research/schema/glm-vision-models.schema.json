{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dsh-feishu/research/glm-vision-models",
  "title": "R1 GLM vision model ground truth",
  "type": "object",
  "required": ["researchedAt", "models"],
  "additionalProperties": false,
  "properties": {
    "researchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "researchedBy": { "type": "string" },
    "summary": { "type": "string" },
    "conflictsWithBaseline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "baseline", "finding", "explanation"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "baseline": {},
          "finding": {},
          "explanation": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "contextWindow", "input", "stability", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^glm-" },
          "endpoints": { "type": "array", "items": { "enum": ["coding", "paas"] }, "minItems": 1 },
          "contextWindow": { "type": ["integer", "null"] },
          "maxOutputTokens": { "type": ["integer", "null"] },
          "input": { "type": "array", "items": { "enum": ["text", "image"] }, "minItems": 1 },
          "maxImagesPerRequest": { "type": ["integer", "null"] },
          "imageConstraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxBytes": { "type": ["integer", "null"] },
              "maxDimensionPx": { "type": ["integer", "null"] },
              "maxPixels": { "type": ["integer", "null"] },
              "downscaleBehavior": { "type": ["string", "null"] }
            }
          },
          "pricing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "currency": { "type": "string" },
              "inputPerMTokens": { "type": ["number", "null"] },
              "outputPerMTokens": { "type": ["number", "null"] },
              "notes": { "type": "string" }
            }
          },
          "stability": { "enum": ["ga", "beta", "experimental", "undocumented"] },
          "deprecated": { "type": "boolean" },
          "recommended": { "type": "boolean" },
          "notes": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "pattern": "^https?://" },
            "minItems": 1
          }
        }
      }
    }
  }
}
